{
  "name": "gmbranker/gmb-ranker-seo-automation",
  "description": "Enterprise-grade WordPress SEO Automation & Intelligence Engine.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "GMB Ranker",
      "homepage": "https://gmbranker.org"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.0",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload": {
    "classmap": [
      "includes/"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs -p -s -v --standard=phpcs.xml.dist",
    "phpcbf": "phpcbf -p -s -v --standard=phpcs.xml.dist"
  }
}
